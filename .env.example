# ---------------------------------------------------------------------------
# PIM 2 Community Ecosystem Mapping - contoh konfigurasi
# Salin file ini menjadi .env lalu isi nilai yang diperlukan.
# Aplikasi TETAP JALAN tanpa file .env sama sekali (Leaflet + localStorage).
# ---------------------------------------------------------------------------

# Penyedia peta: "leaflet" (OpenStreetMap, tanpa API key) atau "google"
VITE_MAP_PROVIDER=leaflet

# Hanya dibutuhkan bila VITE_MAP_PROVIDER=google
VITE_GOOGLE_MAPS_API_KEY=
# Opsional: Map ID untuk Advanced Marker (buat di Google Cloud Console)
VITE_GOOGLE_MAPS_MAP_ID=

# Supabase - isi KEDUANYA untuk memindahkan penyimpanan dari localStorage ke Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Email akun tim bersama (dibuat di Supabase > Authentication > Users).
# Halaman masuk hanya meminta password; email ini dipasangkan otomatis.
VITE_SUPABASE_LOGIN_EMAIL=tim@pim2.local
